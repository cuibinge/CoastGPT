{
  "model_type": "coastgpt-aquaculture-detection",
  "architectures": ["MaskRCNN"],
  "num_classes": 2,
  "classes": ["background", "aquaculture"],
  "backbone": {
    "arch": "dual",
    "global_encoder": "dinov3_vitl16",
    "local_encoder": "convnext_base",
    "alignment_dim": 1024,
    "out_channels": [128, 256, 512, 1024],
    "pretrained_weights": [
      "dinov3_vitl16_pretrain_sat493m-eadcf0ff.pth",
      "dinov3_convnext_base_pretrain_lvd1689m-801f2ba9.pth"
    ]
  },
  "fpn": {
    "out_channels": 256
  },
  "rpn": {
    "anchor_generator": {
      "mode": "relative",
      "scales": [[0.0357, 0.0714, 0.1429], [0.1429, 0.2857], [0.2857, 0.4286, 0.5714]],
      "aspect_ratios": [0.5, 1.0, 2.0, 3.0]
    },
    "pre_nms_top_n_train": 2000,
    "pre_nms_top_n_test": 1000,
    "post_nms_top_n_train": 2000,
    "post_nms_top_n_test": 1000
  },
  "roi_heads": {
    "box_head": "TwoMLPHead",
    "mask_head": "MaskRCNNHeads"
  },
  "training": {
    "dataset": "GF1/GF2/GF6 aquaculture tiles (Stage3Data/养殖区)",
    "image_size": 224,
    "loss": "Mask R-CNN (RPN + Box + Mask)",
    "epochs": 50
  }
}
